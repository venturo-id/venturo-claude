{
  "//": "VARIAN NON-PLUGIN. Pakai ini HANYA kalau kamu tidak mau install plugin venturo-arsenal dan lebih suka menyalin hooks/ ke .claude/hooks/ di satu repo. Salin isi file ini ke .claude/settings.json repo tersebut, lalu salin seluruh isi hooks/ (termasuk _lib.sh) ke .claude/hooks/. Kalau kamu memakai plugin-nya, JANGAN pakai file ini — hook akan jalan dua kali.",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Read",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-go.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-ts.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify-stop.sh" }
        ]
      }
    ]
  }
}
